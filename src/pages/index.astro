<style>
  :root {
    color-scheme: light dark;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    min-height: 100vh;
    display: grid;
    place-items: center;
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    background: #0f1115;
    color: #e6e8ee;
  }

  main {
    max-width: 36rem;
    padding: 2rem;
    text-align: center;
  }

  h1 {
    margin: 0;
    font-size: 2.5rem;
    letter-spacing: -0.02em;
  }

  .role {
    margin: 0.5rem 0 1.5rem;
    font-size: 1.1rem;
    color: #8b93a7;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .tagline {
    color: #aeb5c4;
    line-height: 1.6;
  }

  .links {
    margin-top: 2rem;
    display: flex;
    gap: 1rem;
    justify-content: center;
  }

  .links a {
    color: #e6e8ee;
    text-decoration: none;
    padding: 0.5rem 1rem;
    border: 1px solid #2a2f3a;
    border-radius: 8px;
    transition: border-color 0.15s, background 0.15s;
  }

  .links a:hover {
    border-color: #4b5568;
    background: #1a1e26;
  }
</style>
