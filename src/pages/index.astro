    </main>

    <script>
      const toggles = document.querySelectorAll<HTMLButtonElement>('[data-toggle-list]');
      toggles.forEach((button) => {
        const list = button.previousElementSibling as HTMLUListElement | null;
        if (!list) return;
        const limit = Number(list.dataset.limit ?? '4');
        if (list.children.length <= limit) {
          button.remove();
          return;
        }
        button.addEventListener('click', () => {
          const expanded = list.classList.toggle('is-expanded');
          button.setAttribute('aria-expanded', String(expanded));
          button.textContent = expanded ? 'Show less' : 'Show more';
        });
      });
    </script>
