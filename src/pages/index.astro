<style>
  :root {
    color-scheme: light dark;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    min-height: 100vh;
    display: grid;
    place-items: center;
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    background: #0f1115;
    color: #e6e8ee;
  }

  main {
    width: 100%;
    max-width: 64rem;
    padding: 2rem;
    text-align: center;
  }

  h1 {
    margin: 0;
    font-size: 2.5rem;
    letter-spacing: -0.02em;
  }

  .role {
    margin: 0.5rem 0 1.5rem;
    font-size: 1.1rem;
    color: #8b93a7;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .tagline {
    color: #aeb5c4;
    line-height: 1.6;
  }

  .links {
    margin-top: 2rem;
    display: flex;
    gap: 1rem;
    justify-content: center;
  }

  .links a {
    color: #e6e8ee;
    text-decoration: none;
    padding: 0.5rem 1rem;
    border: 1px solid #2a2f3a;
    border-radius: 8px;
    transition: border-color 0.15s, background 0.15s;
  }

  .links a:hover {
    border-color: #4b5568;
    background: #1a1e26;
  }

  .columns {
    margin-top: 3rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  .section {
    text-align: left;
  }

  .section h2 {
    font-size: 0.95rem;
    margin: 0 0 1rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #8b93a7;
    border-bottom: 1px solid #2a2f3a;
    padding-bottom: 0.5rem;
  }

  .entry-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .entry {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .entry-title {
    color: #e6e8ee;
    font-weight: 500;
    line-height: 1.4;
  }

  .entry-title a {
    color: #e6e8ee;
    text-decoration: none;
    border-bottom: 1px solid #4b5568;
  }

  .entry-title a:hover {
    color: #fff;
    border-color: #8b93a7;
  }

  .entry-meta {
    color: #8b93a7;
    font-size: 0.85rem;
  }

  .entry-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.15rem;
  }

  .entry-links a {
    color: #a9c4ff;
    text-decoration: none;
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    border: 1px solid #33517f;
    background: rgba(91, 140, 255, 0.1);
    transition: border-color 0.15s, background 0.15s, color 0.15s;
  }

  .entry-links a:hover {
    color: #fff;
    border-color: #5b8cff;
    background: rgba(91, 140, 255, 0.22);
  }

  .toggle-btn {
    display: none;
    margin-top: 1rem;
    background: none;
    border: 1px solid #2a2f3a;
    color: #8b93a7;
    font-size: 0.85rem;
    padding: 0.45rem 0.9rem;
    border-radius: 8px;
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s, background 0.15s;
  }

  .toggle-btn:hover {
    color: #e6e8ee;
    border-color: #4b5568;
    background: #1a1e26;
  }

  /* Tablet and below: stack the two sections into a single column. */
  @media (max-width: 760px) {
    .columns {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  /* Small devices: show only a preview of each list, with a button to expand it. */
  @media (max-width: 640px) {
    .toggle-btn {
      display: inline-block;
    }

    .entry-list.is-collapsible .entry:nth-child(n + 5) {
      display: none;
    }

    .entry-list.is-collapsible.is-expanded .entry:nth-child(n + 5) {
      display: flex;
    }
  }
</style>
